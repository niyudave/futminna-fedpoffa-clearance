# DATABASE_URL: MySQL Database connection string for Prisma ORM
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# DB_MODE: Storage backend mode ('MYSQL' enforces strict real MySQL connection; 'IN_MEMORY' or 'AUTO' allows fallback in development)
DB_MODE="AUTO"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for authentication
JWT_SECRET=

# CLIENT_ORIGIN: Allowed CORS origin for Socket.IO real-time connections (defaults to http://localhost:5173)
CLIENT_ORIGIN="http://localhost:5173"

# EMAIL NOTIFICATION SERVICE (SMTP / Mail Delivery Configuration)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="clearance-portal@futminna-fedpoffa.edu.ng"
EMAIL_NOTIFICATION_ENABLED=true
